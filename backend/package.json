{
  "name": "mindful-ai-sandbox-backend",
  "version": "0.1.0",
  "description": "Backend API and Lambda functions for Mindful AI Sandbox",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "dev:watch": "nodemon --exec ts-node src/server.ts",
    "dev:local": "cross-env AUTH_MODE=local ts-node src/server.ts",
    "dev:local:watch": "cross-env AUTH_MODE=local nodemon --exec ts-node src/server.ts",
    "build": "tsc && npm run bundle",
    "bundle": "node scripts/bundle-lambdas.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:contract": "jest --testPathPattern=tests/contract",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts,.js",
    "lint:fix": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts,.js --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "type-check": "tsc --noEmit",
    "validate:openapi": "npx @apidevtools/swagger-cli validate openapi.yaml",
    "clean": "rm -rf dist build",
    "prepare": "husky || true"
  },
  "keywords": [
    "aws",
    "lambda",
    "serverless",
    "sandbox"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1126.0",
    "@aws-sdk/client-dynamodb": "^3.1126.0",
    "@aws-sdk/lib-dynamodb": "^3.1126.0",
    "@aws-sdk/util-dynamodb": "^3.993.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "serverless-http": "^4.0.0",
    "uuid": "^9.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^22.19.20",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.46.2",
    "aws-lambda": "^1.0.7",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-jest": "^4.1.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "js-yaml": "^4.2.0",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "openapi-response-validator": "^12.1.3",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "cross-env ESLINT_USE_FLAT_CONFIG=false eslint --fix",
      "prettier --write",
      "cross-env ESLINT_USE_FLAT_CONFIG=false eslint"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
