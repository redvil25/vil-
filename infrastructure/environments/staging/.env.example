# Terraform secrets -- source this file before running Terraform:
#
#   source .env
#   terraform plan
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# This file is git-ignored. Never commit your .env file.

# GitHub personal access token for Amplify (see Step 1b in Terraform Configuration Guide)
# Create at: https://github.com/settings/tokens -- select the "repo" scope
export TF_VAR_github_access_token=""

# Google OAuth secret (optional -- only needed if enabling Google login)
# export TF_VAR_google_client_secret=""
